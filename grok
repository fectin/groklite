# Show usage help and exit
get_help() {
  printf "grok - get answers from an AI\n\n"
  printf "Usage: grok [-t topic [-m model] [-r temp] | -l | -h] [query]\n\n"
  printf "Options:\n"
  printf "  -t topic  Start conversation (interactive only, supports 'last'/'latest')\n"
  printf "  -l        List available topics\n"
#  printf "  -d topic  Delete topic history\n"
#  printf "  -i        Force interactive mode\n"
  printf "  -m model  Set model (default: %s)\n" "$model"
  printf "  -r temp   Set temperature 0-2 (default: %s, omit field / server default)\n" "$temperature"
  printf "  -h        Show this help\n"
  printf "\n"
  printf "No args: Interactive mode with auto-assigned topic\n"
  printf "With query: Single-shot response, no history\n"
  exit 0
}

log() {
  [ "$debug" == true ] && printf "$@\n"
  [ "$logging" == "full" ] && echo "$@" >> "$logfile$(date +%Y%m%d)"
}

