# Show usage help and exit
get_help() {
  printf "grok - get answers from an AI\n\n"
  printf "Usage: grok [-k] [-t topic [-m model] [-r temp] | -l | -h] [query]\n\n"
  printf "Options:\n"
  printf "  -k        Open the API key menu, even if a key is already set\n"
  printf "  -t topic  Start conversation (interactive only, supports 'last'/'latest')\n"
  printf "  -l        List available topics\n"
#  printf "  -d topic  Delete topic history\n"
#  printf "  -i        Force interactive mode\n"
  printf "  -m model  Set model (default: %s)\n" "$model"
  printf "  -r temp   Set temperature 0-2 (default: %s, omit field / server default)\n" "$temperature"
  printf "  -h        Show this help\n"
  printf "\n"
  printf "API key: environment, then ~/.config/grok.env, then /etc/grok/api-key\n"
  printf "No args: Interactive mode with auto-assigned topic\n"
  printf "With query: Single-shot response, no history\n"
  exit 0
}

# xAI keys start with xai-. Length is not fixed.
normalize_key() {
  local k=$1
  k=${k%$'\r'}
  k=${k#"${k%%[![:space:]]*}"}
  k=${k%"${k##*[![:space:]]}"}
  case $k in
    \"*\") k=${k#\"}; k=${k%\"} ;;
    \'*\') k=${k#\'}; k=${k%\'} ;;
  esac
  k=${k#"${k%%[![:space:]]*}"}
  k=${k%"${k##*[![:space:]]}"}
  printf '%s' "$k"
}

key_sane() {
  local k=$1 body n
  n=${#k}
  [ "$n" -ge 8 ] && [ "$n" -le 500 ] || return 1
  body=${k#xai-}
  [ "$body" != "$k" ] && [ -n "$body" ] || return 1
  [[ $body =~ ^[[:graph:]]+$ ]]
}

reject_stored_key() {
  log "Ignoring API key from $1: it should start with xai- and contain no spaces."
}

load_user_key() {
  local line val
  _loaded_key=
  [ -r "$user_key_file" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      ''|\#*) continue ;;
    esac
    case $line in
      export\ *) line=${line#export } ;;
    esac
    case $line in
      GROK_API_KEY=*)
        val=$(normalize_key "${line#GROK_API_KEY=}")
        _loaded_key=$val
        return 0
        ;;
    esac
  done < "$user_key_file"
  return 1
}

load_common_key() {
  local line
  _loaded_key=
  [ -r "$common_key_file" ] || return 1
  IFS= read -r line < "$common_key_file" || return 1
  _loaded_key=$(normalize_key "$line")
  return 0
}

run_as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    sudo "$@"
  fi
}

write_user_key() {
  local key=$1 dir tmp
  dir=$HOME/.config
  mkdir -p "$dir" || return 1
  tmp=$(umask 077; mktemp "$dir/grok.env.XXXXXX") || return 1
  if ! printf 'GROK_API_KEY=%s\n' "$key" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$user_key_file" || { rm -f "$tmp"; return 1; }
  log "Saved key for your user in $user_key_file"
}

write_machine_key() {
  local key=$1 tmp target_user
  tmp=$(umask 077; mktemp) || return 1
  if ! printf '%s\n' "$key" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  if ! run_as_root mkdir -p -m 755 /etc/grok; then
    rm -f "$tmp"
    log "Could not create /etc/grok."
    return 1
  fi
  if ! getent group grok >/dev/null; then
    if ! run_as_root groupadd --system grok; then
      rm -f "$tmp"
      log "Could not create group grok."
      return 1
    fi
  fi
  if ! run_as_root install -m 640 -o root -g grok "$tmp" "$common_key_file"; then
    rm -f "$tmp"
    log "Could not install $common_key_file."
    return 1
  fi
  rm -f "$tmp"
  target_user=${USER:-$(id -un)}
  if ! id -nG "$target_user" | tr ' ' '\n' | grep -qx grok; then
    if ! run_as_root usermod -aG grok "$target_user"; then
      log "Saved shared key in $common_key_file, but could not add $target_user to group grok."
      log "This run will use the key you just entered."
      return 0
    fi
  fi
  if [ -r "$common_key_file" ]; then
    log "Saved shared key in $common_key_file (readable by group grok)."
  else
    log "Saved shared key in $common_key_file."
    log "This session cannot read it yet. Log in again so membership in group grok applies. This run will use the key you just entered."
  fi
}

prompt_for_key() {
  local choice key
  if [ ! -t 0 ]; then
    if [ "$force_key_menu" = true ]; then
      log "Cannot open the API key menu: not a terminal."
    else
      log "No API key found."
      log "Set GROK_API_KEY, or store it in $user_key_file, or in $common_key_file."
    fi
    return 1
  fi
  while true; do
    if [ "$force_key_menu" = true ]; then
      printf 'API key:\n' >&2
    else
      printf 'No API key found.\n' >&2
    fi
    printf '  u  save for just you      %s\n' "$user_key_file" >&2
    printf '  m  save for this machine  %s (group grok, uses sudo)\n' "$common_key_file" >&2
    printf '  n  this run only          do not save it\n' >&2
    printf '  q  quit\n' >&2
    printf 'Choice: ' >&2
    IFS= read -r choice < /dev/tty || return 1
    case $choice in
      u|U|user) ;;
      m|M|machine) ;;
      n|N|now) ;;
      q|Q|quit|'') return 1 ;;
      *) printf 'Enter u, m, n, or q.\n' >&2; continue ;;
    esac
    printf 'Paste the key (input hidden): ' >&2
    IFS= read -rs key < /dev/tty || return 1
    printf '\n' >&2
    key=$(normalize_key "$key")
    if ! key_sane "$key"; then
      printf 'That key should start with xai- and be one token with no spaces.\n' >&2
      continue
    fi
    case $choice in
      u|U|user)
        write_user_key "$key" || continue
        ;;
      m|M|machine)
        write_machine_key "$key" || continue
        ;;
      n|N|now)
        log "Using the key for this run only."
        ;;
    esac
    GROK_API_KEY=$key
    unset _parent_grok_api_key
    return 0
  done
}

accept_key() {
  GROK_API_KEY=$1
  unset _parent_grok_api_key _loaded_key
  return 0
}

ensure_api_key() {
  local candidate
  if [ "$force_key_menu" = true ]; then
    prompt_for_key
    return
  fi
  if [ "$_parent_grok_api_key_set" -eq 1 ]; then
    candidate=$(normalize_key "$_parent_grok_api_key")
    if key_sane "$candidate"; then
      accept_key "$candidate"
      return 0
    fi
    reject_stored_key 'the environment'
  fi
  if load_user_key; then
    if key_sane "$_loaded_key"; then
      accept_key "$_loaded_key"
      return 0
    fi
    reject_stored_key "$user_key_file"
  fi
  if load_common_key; then
    if key_sane "$_loaded_key"; then
      accept_key "$_loaded_key"
      return 0
    fi
    reject_stored_key "$common_key_file"
  fi
  # Legacy path: source /etc/environment may have set this.
  if [ "$_parent_grok_api_key_set" -eq 0 ] && [ -n "${GROK_API_KEY:-}" ]; then
    candidate=$(normalize_key "$GROK_API_KEY")
    if key_sane "$candidate"; then
      accept_key "$candidate"
      return 0
    fi
    reject_stored_key '/etc/environment'
  fi
  unset _loaded_key
  prompt_for_key
}

