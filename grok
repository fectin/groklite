log "==========$(date +%Y%m%d::%H:%M:%S)==========\n"
action_flag=""
set_topic "" #empty call will default to a date+number
while getopts "h?lt:m:r:" opt; do    #change to "h?ld:t:m:r:" when the delete function goes in
  case $opt in
    h) [ -n "$action_flag" ] && bad_flags_error || action_flag="h"; get_help;;                  # Show help for -h
    \?) [ -n "$action_flag" ] && bad_flags_error || action_flag="h"; get_help;;                 # Show help for -?
    l) [ -n "$action_flag" ] && bad_flags_error || action_flag="l"; list_topics;;               # List topics and exit (stub)
#    d) [ -n "$action_flag" ] && bad_flags_error || action_flag="d"; delete_topic "$OPTARG";;   # Delete topic and exit (stub)
#    M) [ -n "$action_flag" ] && bad_flags_error || action_flag="M"; printf "$list models"; exit 0;;
    t) [ -n "$action_flag" ] && bad_flags_error || action_flag="t"; set_topic "$OPTARG";;       # Validate and set topic
    m) model="$OPTARG";; # Set model
    r) temperature="$OPTARG"
       # 0-2 kept; anything else (including -1) omits the field / server default
       if ! jq -ne --argjson t "$temperature" '$t >= 0 and $t <= 2' >/dev/null 2>&1; then
         temperature=-1
       fi
       ;;

  esac
done

      shift $((OPTIND-1)) # Remove processed flags, leaving query in $@
      
      converse $@
